for (i in seq(1:16)){
print(i)
}
for (i in seq(1:16)){
print(i*seq(1:8))
}
print(i*seq(1:8)+24)
print(seq(1:8))
index_to_well(8)
index_to_well(8+24)
index_to_well(8+48)
n = n+24
n <- n + 24
n <- 0
for (i in seq(1:16)){
n <- 0
print(seq(1:8) + i*n)
n <- n + 24
}
n <- 0
for (i in seq(1:16)){
print(seq(1:8) + i*n)
n <- n + 24
}
n <- 0
for (i in seq(1:16)){
